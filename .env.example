# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for answers (default: claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-haiku-4-5-20251001
# 1 = canned/extractive answers, no API key needed (tests and offline demo)
MOCK_LLM=1
# Where consented leads are appended (CSV)
LEADS_PATH=./leads.csv
# Optional: POST each new lead as JSON to this URL (e.g. the n8n webhook in n8n/).
# Must be https:// (http:// only for localhost/127.0.0.1). Redirects are not followed.
LEAD_WEBHOOK_URL=
# Sent as X-Webhook-Secret header; configure the same value in the n8n Header Auth credential
LEAD_WEBHOOK_SECRET=
# Leads older than 90 days are deleted at startup and then every N hours
LEAD_PURGE_INTERVAL_HOURS=24
# Comma-separated origins allowed to embed the widget (CORS). "*" for the demo only.
ALLOWED_ORIGINS=*
# BM25 score below which a question counts as "not covered by our content"
MIN_RETRIEVAL_SCORE=2.0
# Share of question words that must appear in our content (filters one-word coincidences)
MIN_QUERY_COVERAGE=0.5

# --- Abuse limits (in-memory, per process; 0 = unlimited) ---
# Max request body in bytes (larger requests get HTTP 413)
MAX_BODY_BYTES=16384
# Chat messages per IP per minute (HTTP 429 above this)
RATE_LIMIT_PER_MINUTE=20
# Saved booking requests per IP per 24 hours
LEADS_PER_IP_PER_DAY=3
# Claude calls per UTC day; when used up, the bot answers with the human handoff instead
LLM_DAILY_CALL_BUDGET=1000
# Behind a reverse proxy: the proxy's IP, so uvicorn uses X-Forwarded-For as the client IP
FORWARDED_ALLOW_IPS=127.0.0.1
