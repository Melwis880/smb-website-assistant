# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for answers (default: claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-haiku-4-5-20251001
# 1 = canned/extractive answers, no API key needed (tests and offline demo)
MOCK_LLM=1
# Where consented leads are appended (CSV)
LEADS_PATH=./leads.csv
# Optional: POST each new lead as JSON to this URL (e.g. the n8n webhook in n8n/)
LEAD_WEBHOOK_URL=
# Comma-separated origins allowed to embed the widget (CORS). "*" for the demo only.
ALLOWED_ORIGINS=*
# BM25 score below which a question counts as "not covered by our content"
MIN_RETRIEVAL_SCORE=2.0
# Share of question words that must appear in our content (filters one-word coincidences)
MIN_QUERY_COVERAGE=0.5
